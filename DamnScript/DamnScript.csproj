<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Nullable>disable</Nullable>
        <LangVersion>9</LangVersion>
        <TargetFramework>net7.0</TargetFramework>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
      <OutputPath>../_Binaries/Debug/</OutputPath>
      <DefineConstants>TRACE;DAMN_SCRIPT_ENABLE_ASSEMBLER_DEBUG;DAMN_SCRIPT_ENABLE_EXECUTION_LOG;DAMN_SCRIPT_ENABLE_ADDITIONAL_CHECKS;DAMN_SCRIPT_ENABLE_MEMORY_DEBUG;DAMN_SCRIPT_ENABLE_UNSAFE_SCRIPT_VALUE;</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
      <OutputPath>../_Binaries/Release/</OutputPath>
      <DefineConstants>TRACE;DAMN_SCRIPT_ENABLE_UNSAFE_SCRIPT_VALUE</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Antlr4.Runtime" Version="4.6.6" />
        <PackageReference Include="Antlr4.CodeGenerator" Version="4.6.6">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>
